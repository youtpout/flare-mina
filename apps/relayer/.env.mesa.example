# Relayer against the Mesa testnet.
#
#   cp .env.mesa.example .env.mesa
#   node --env-file=.env.mesa --import tsx src/server.ts
#
# Copy the secrets and the Flare addresses over from your devnet .env — the
# Flare side is unchanged, only the Mina side moves. Everything under "redeploy"
# below is empty on purpose: those zkApps do not exist on Mesa until you put
# them there, and pointing at the devnet addresses would read accounts that are
# not on this chain.

MINA_NETWORK=mesa

# Both default from MINA_NETWORK; set them only to override.
# MINA_GRAPHQL=https://mesa.minataur.net/graphql
# MINA_READ_GRAPHQL=https://mesa.minataur.net/graphql

# Mesa publishes a real archive node, unlike devnet. Nothing reads action
# history today, so this is here for when the burn watcher stops inferring from
# balances and reads the event instead.
# MINA_ARCHIVE=https://archive-node-api.mesa-rc.minaprotocol.com/

# A local node instead of the hosted one:
# MINA_GRAPHQL=http://127.0.0.1:8080/graphql

# --- redeploy on Mesa, then fill these in -----------------------------------

# Escrow zkApp. `deployBridge.ts` prints it.
MINA_BRIDGE_ACCOUNT=
MINA_BRIDGE_PRIVATE_KEY=

# Fee payer. Needs Mesa MINA, which the devnet faucet will not give you.
MINA_DEVNET_PRIVATE_KEY=

# One entry per asset, all redeployed. Same shape as devnet:
# [{"symbol":"bFXRP","flareToken":"0x…","port":"B62…","token":"B62…","tokenId":"…","decimals":6}]
MINA_ASSET_PORTS=

# --- unchanged from devnet ---------------------------------------------------

PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flarexmina_mesa
O1JS_CACHE_DIR=

ATTESTOR_PRIVATE_KEY=
FLARE_SUBMITTER_PRIVATE_KEY=
MINA_WITHDRAWAL_ATTESTOR_PRIVATE_KEY=
MINA_WITHDRAWAL_ATTESTOR=

FLARE_CHAIN_ID=114

# Deployed 14 Aug 2026 for this environment only. Distinct from the devnet set
# on purpose: two relayers sharing one TransferChain both read the same
# Transferred events and each advances a cursor the other never sees.
FLARE_BRIDGE_ADDRESS=0x06E584e72b36494Bb84A2C1df34E665Cf7673517
FLARE_FMINA_ADDRESS=0x05b5e8505e35505233955080f02b7351747B1C7f
FLARE_ASSET_VAULT_ADDRESS=0x669BDaa9B9802Ca92A4Ed5a29933805B09E33EeC
FLARE_TRANSFER_CHAIN_ADDRESS=0x56Ae0044E5115A84137908006eC24994896157E1

# Shared with devnet on purpose: the factory derives account addresses with
# CREATE2 over a Mina public key, so a second one would give every user a
# different Flare account for the same key.
FLARE_ACCOUNT_FACTORY=0x2a2AcdD54B93675828028fb8108fACc0A387fe23

MINA_SIGNING_POLICY_ROOT=
