# Attestor API.
#
# NOTHING here can move funds. The attestation this service produces is only
# half of what a mint requires — the depositor's own Schnorr signature binds the
# recipient and the amount, and the Flare contract verifies it. A compromised
# attestor can attest to an escrow that never happened; it cannot choose who
# gets paid.

PORT=8787

# Coolify's Postgres, on the internal network. TLS is neither required nor
# available there; set PGSSL=require for a managed provider instead.
DATABASE_URL=postgres://user:password@postgres:5432/flarexmina
# PGSSL=require

# Signs attestations. Must equal MinaPortBridge.escrowAttestor().
ATTESTOR_PRIVATE_KEY=0x...

# Escrow account being watched, and how deeply a payment must be buried.
MINA_BRIDGE_ACCOUNT=B62qrnXemTz7RhG8kKwv7id9eHTAVMafTiDrPMyDTMJUSUfpPQYPuMH
# o1's own node since the 19 August Mesa hard fork. Others kept serving the
# abandoned fork and answered account queries from it without saying so.
MINA_GRAPHQL=https://devnet-plain-1.gcp.o1test.net/graphql
MINA_ARCHIVE=https://devnet-archive-node-api.gcp.o1test.net/
MINA_CONFIRMATIONS=2
WATCH_INTERVAL_MS=20000

# Bounds on what a single attestation is worth. The upper bound is not
# paranoia: this key causes mints, so capping one signature bounds the damage
# if the watcher is ever fooled.
MIN_DEPOSIT_NANOMINA=100000000
MAX_DEPOSIT_NANOMINA=1000000000000

FLARE_CHAIN_ID=114

# Pays the gas for claims on Flare. The signature is the authorisation, so
# this key can only decline to submit — it cannot redirect or resize a mint.
FLARE_SUBMITTER_PRIVATE_KEY=0x...
FLARE_BRIDGE_ADDRESS=0xdb78DA6dd5eC73b7089799eE85Fc2E43126CBae2
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_ACCOUNT_FACTORY=0x2a2AcdD54B93675828028fb8108fACc0A387fe23
