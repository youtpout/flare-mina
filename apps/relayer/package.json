{
  "name": "@flarexmina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "warm-cache": "node --max-old-space-size=12288 dist/src/prover/warmCache.js"
  },
  "dependencies": {
    "@minaport/mina-contracts": "workspace:*",
    "@minaport/shared": "workspace:*",
    "@o1js/native": "3.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mina-fungible-token": "^1.1.0",
    "o1js": "3.0.0",
    "pg": "^8.13.1",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
