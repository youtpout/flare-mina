{
  "name": "minaport",
  "private": true,
  "version": "0.1.0",
  "description": "MinaPort — native MINA liquidity on Flare via a fully collateralized wMINA token",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r test",
    "test:ts": "pnpm -r --filter \"./packages/**\" test",
    "test:sol": "cd packages/flare-contracts && forge test -vv",
    "test:rust": "cd packages/prover && cargo test --workspace",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "web": "pnpm --filter @minaport/web dev",
    "relayer": "pnpm --filter @minaport/relayer dev",
    "fixtures": "pnpm --filter @minaport/shared fixtures"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
