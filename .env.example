# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Generate a throwaway key with:
#   cast wallet new
#
# Fund it at https://faucet.flare.network (100 C2FLR, 10 USD₮0, 10 FXRP per
# address per 24 hours). Deployment plus a handful of demo transactions fits
# comfortably in one allowance; seeding a swap pool does not, so plan on
# several addresses or several days.
#
# NEVER put a key holding real value in this file.
DEPLOYER_ADDRESS=0x...
PRIVATE_KEY=0x...

COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_EXPLORER=https://coston2-explorer.flare.network

# Mina devnet. Generate with:
#   node -e "import('mina-signer').then(({default:C})=>console.log(new C({network:'testnet'}).genKeys()))"
# Fund at https://faucet.minaprotocol.com (select Devnet).
#
# Must NOT be the demo key committed in packages/shared/tools/signAuthorization.mjs.
# That one is public by design, for signing test vectors, and must never hold value.
MINA_DEVNET_ADDRESS=B62...
MINA_DEVNET_PRIVATE_KEY=EK...
MINA_DEVNET_GRAPHQL=https://api.minascan.io/node/devnet/v1/graphql
