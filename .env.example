# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Generate a throwaway key with:
#   cast wallet new
#
# Fund it at https://faucet.flare.network (100 C2FLR, 10 USD₮0, 10 FXRP per
# address per 24 hours). Deployment plus a handful of demo transactions fits
# comfortably in one allowance; seeding a swap pool does not, so plan on
# several addresses or several days.
#
# NEVER put a key holding real value in this file.
DEPLOYER_ADDRESS=0x...
PRIVATE_KEY=0x...

COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_EXPLORER=https://coston2-explorer.flare.network

# Mina devnet. Generate with:
#   node -e "import('mina-signer').then(({default:C})=>console.log(new C({network:'testnet'}).genKeys()))"
# Fund at https://faucet.minaprotocol.com (select Devnet).
#
# Must NOT be the demo key committed in packages/shared/tools/signAuthorization.mjs.
# That one is public by design, for signing test vectors, and must never hold value.
MINA_DEVNET_ADDRESS=B62...
MINA_DEVNET_PRIVATE_KEY=EK...
MINA_DEVNET_GRAPHQL=https://api.minascan.io/node/devnet/v1/graphql

# ---------------------------------------------------------------------------
# Deployed addresses (Coston2). Filled in by the deploy scripts.
# ---------------------------------------------------------------------------

FLARE_BRIDGE_ADDRESS=0x...          # MinaPortBridge proxy
FLARE_ASSET_VAULT_ADDRESS=0x...     # AssetVault proxy
FLARE_FMINA_ADDRESS=0x...           # bridge.TOKEN()

# The shared chain every Flare -> Mina transfer folds into, so one FDC
# attestation covers every asset that moved. Unset means the Flare -> Mina rail
# is off, which is a supported deployment.
FLARE_TRANSFER_CHAIN_ADDRESS=0x...

# One JSON entry per wrapped asset. `flareToken` is the single source of truth
# for which asset a port administers — the migration script reads it from here.
MINA_ASSET_PORTS=[{"symbol":"bFXRP","flareToken":"0x...","port":"B62...","token":"B62...","decimals":6}]

# How many releases the relayer sends before waiting on a block. Mina checks a
# state precondition when the transaction is applied, so a wave proved against
# each predecessor's cursor rides one block. 1 restores the old behaviour.
RELEASE_WAVE_SIZE=5
# How long to watch the cursor for a wave that has been sent. Anything it never
# reaches stays `releasing` and is rebuilt from chain on the next tick.
RELEASE_CONFIRM_MS=480000
# Mints per port before waiting on a block. Defaults to RELEASE_WAVE_SIZE.
MINT_WAVE_SIZE=5
MINT_CONFIRM_MS=480000
