# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Generate a throwaway key with:
#   cast wallet new
#
# Fund it at https://faucet.flare.network (100 C2FLR, 10 USD₮0, 10 FXRP per
# address per 24 hours). Deployment plus a handful of demo transactions fits
# comfortably in one allowance; seeding a swap pool does not, so plan on
# several addresses or several days.
#
# NEVER put a key holding real value in this file.
DEPLOYER_ADDRESS=0x...
PRIVATE_KEY=0x...

COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_EXPLORER=https://coston2-explorer.flare.network
